# ── Database ──────────────────────────────────────
POSTGRES_DB=command_center
POSTGRES_USER=cc_admin
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# ── Redis ─────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_strong_password_here

# ── Grafana ───────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_strong_password_here

# ── n8n ───────────────────────────────────────────
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_strong_password_here
N8N_ENCRYPTION_KEY=CHANGE_ME_make_this_a_long_random_string_32_chars

# ── n8n API Integration ───────────────────────────
# Generate this at: http://localhost:5678 > Settings > API > Create API Key
N8N_API_KEY=

# ── Metabase ──────────────────────────────────────
METABASE_DB_FILE=/metabase-data/metabase.db

# ── Ollama ────────────────────────────────────────
OLLAMA_HOST=0.0.0.0

# ── API ───────────────────────────────────────────
API_PORT=8080
